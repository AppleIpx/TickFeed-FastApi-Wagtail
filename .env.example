# Скопировать в .env и заменить changethis на реальный пароль.
# .env не коммитится.

FASTAPI_ENV=development
PROJECT_NAME=TickFeed

# Пароль пользователя postgres. compose.yml собирает из него DATABASE_URL для контейнера backend.
POSTGRES_PASSWORD=changethis

# Для запуска backend с хоста (fastapi dev, alembic, pytest) против db из docker compose.
DATABASE_URL=postgresql://postgres:changethis@localhost:5432/app
